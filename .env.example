# Copy this file to .env. Local Ollama needs no API key.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:0.8b
HOST=127.0.0.1
PORT=8787

# For cloud sign-in and chat sync, add your Firebase web app settings to the
# Vite variables below. Copy these values from Firebase Console > Project settings.
# The app stays usable locally while these are blank.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Add the two private BitHuman agent codes after creating them in your account.
BITHUMAN_AGENT_MALE=
BITHUMAN_AGENT_FEMALE=
BITHUMAN_API_SECRET=
# Generate a long random value for this server-only key and set the same value
# as the OpenAI-compatible provider key in BitHuman.
BITHUMAN_GATEWAY_KEY=
BITHUMAN_GATEWAY_MODEL=gpt-6.1-terra

# Optional paid provider instead:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-6.1-terra
